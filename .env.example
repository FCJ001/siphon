# ============ Siphon 配置 ============
# 管理密码 & 对外 API key(同值; P0 单租户)
SIPHON_MASTER_KEY=change-me-to-a-long-random-string

SIPHON_HOST=127.0.0.1
SIPHON_PORT=4100
# SQLite 落盘位置(记账/账号/配额快照)
SIPHON_DB=data/siphon.db

# ============ 上游: OpenCode Go ============
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# 首次启动且账号表为空时引导建号(逗号分隔); 之后一律在前端「账号」页管理
OPENCODE_KEYS=

# ============ 配额与调度 ============
SIPHON_POLL_INTERVAL=300        # /usage 轮询间隔(秒)
SIPHON_AFFINITY_TTL=3600        # 会话粘账号时长(秒)
SIPHON_PRIMARY_INFLIGHT_CAP=24  # 主力在途上限, 超出走下一把 key
SIPHON_MODEL_DOWN_TTL=900       # 模型级熔断(秒)
SIPHON_ACCOUNT_DOWN_TTL=600     # 账号级熔断兜底(秒)
SIPHON_UPSTREAM_TIMEOUT=300
SIPHON_UPSTREAM_RETRIES=2       # 仅"未向客户端发出字节"的失败才重试

# ============ 计价(USD / 1M tokens, 瀑布图口径) ============
SIPHON_PRICES={"deepseek-v4-flash":[0.14,0.28],"deepseek-v4-flash-vision-exp":[0.14,0.28],"deepseek-v4.1-flash":[0.14,0.28],"deepseek-v4-pro":[1.74,3.48],"mimo-v2.5":[0.0,0.0]}
SIPHON_DEFAULT_PRICE=[0.5,1.5]
SIPHON_CACHED_RATIO=0.1         # 缓存命中按 1/10 价(实测 0.1x)
SIPHON_MODEL_CAPS_USD={"deepseek-v4.1-flash":15,"deepseek-v4-flash":30,"mimo-v2.5":30}
SIPHON_CAP_SAFETY=0.9           # 模型级上限用到 90% 即降权

# ============ 优化器(frontend.md §4.2) ============
SIPHON_OPT_EFFORT=1
SIPHON_OPT_EFFORT_FIRST=low     # 首轮(选工具)档位
SIPHON_OPT_EFFORT_MID=medium    # 中间轮档位
SIPHON_OPT_EFFORT_MID_UNTIL=4   # 工具轮数 >= 该值后不再降(保留出结论档)
SIPHON_OPT_KLINE=1
SIPHON_OPT_KLINE_KEEP=20        # 日K保留根数
SIPHON_OPT_REPLAY=1
SIPHON_OPT_REPLAY_TTL=180       # 回放缓存 TTL(秒)
SIPHON_OPT_REPLAY_MAX_TEMP=0.1  # 温度高于该值不回放
